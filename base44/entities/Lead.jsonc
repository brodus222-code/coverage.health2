{
  "name": "Lead",
  "type": "object",
  "properties": {
    "zip": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "household": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "age_range": {
      "type": "string"
    },
    "income": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "variant": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ],
      "default": "A"
    },
    "tcpa_consent": {
      "type": "boolean"
    },
    "tcpa_consent_text": {
      "type": "string"
    },
    "tcpa_timestamp": {
      "type": "string"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "gclid": {
      "type": "string"
    },
    "fbclid": {
      "type": "string"
    },
    "msclkid": {
      "type": "string"
    },
    "landing_page": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    }
  },
  "required": [
    "zip",
    "phone",
    "tcpa_consent"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}