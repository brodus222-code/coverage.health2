{
  "name": "Lead",
  "type": "object",
  "properties": {
    "zip": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "household": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "age_range": {
      "type": "string"
    },
    "income": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "variant": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ],
      "default": "A"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Contacted",
        "Qualified",
        "Converted",
        "Lost"
      ],
      "default": "New"
    },
    "selected_plan": {
      "type": "string"
    },
    "tcpa_consent": {
      "type": "boolean"
    },
    "tcpa_consent_text": {
      "type": "string"
    },
    "tcpa_timestamp": {
      "type": "string"
    },
    "text_updates_opt_in": {
      "type": "boolean"
    },
    "session_id": {
      "type": "string",
      "description": "Links this lead to its TrafficEvent session"
    },
    "channel": {
      "type": "string",
      "description": "Resolved acquisition channel"
    },
    "is_paid": {
      "type": "boolean",
      "default": false
    },
    "device": {
      "type": "string"
    },
    "referrer": {
      "type": "string"
    },
    "first_landing_page": {
      "type": "string",
      "description": "First page of the session that produced this lead"
    },
    "time_to_convert_seconds": {
      "type": "number"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_term": {
      "type": "string"
    },
    "utm_content": {
      "type": "string"
    },
    "gclid": {
      "type": "string"
    },
    "fbclid": {
      "type": "string"
    },
    "msclkid": {
      "type": "string"
    },
    "landing_page": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "meta_event_id": {
      "type": "string"
    },
    "meta_fbp": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "zip",
    "phone",
    "tcpa_consent"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}