{
  "name": "Auto-Post Blog to Facebook",
  "description": "When a new blog article is published, automatically posts it to the Coverage.Health Facebook Page.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "BlogArticle",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.status == \"published\" and .trigger.data.posted_to_facebook != true }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_post_blog_facebook",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "post_to_facebook": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "postArticleToFacebook",
            "args": {
              "article_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Post to Facebook",
            "description": "Publish to Coverage.Health page"
          }
        }
      }
    ]
  }
}