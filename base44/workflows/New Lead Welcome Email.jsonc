{
  "name": "New Lead Welcome Email",
  "description": "When a new lead is created with an email address, analyzes their health profile via LLM and sends a personalized email confirming the quote request with next steps.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Lead",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.email != null and .trigger.data.email != \"\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_lead_welcome_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_welcome_email": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendLeadWelcomeEmail",
            "args": {
              "email": "${ .trigger.data.email }",
              "full_name": "${ .trigger.data.full_name }",
              "phone": "${ .trigger.data.phone }",
              "zip": "${ .trigger.data.zip }",
              "state": "${ .trigger.data.state }",
              "household": "${ .trigger.data.household }",
              "age": "${ .trigger.data.age }",
              "age_range": "${ .trigger.data.age_range }",
              "income": "${ .trigger.data.income }",
              "variant": "${ .trigger.data.variant }",
              "tcpa_consent": "${ .trigger.data.tcpa_consent }",
              "tcpa_timestamp": "${ .trigger.data.tcpa_timestamp }",
              "landing_page": "${ .trigger.data.landing_page }",
              "utm_source": "${ .trigger.data.utm_source }",
              "utm_campaign": "${ .trigger.data.utm_campaign }",
              "gclid": "${ .trigger.data.gclid }",
              "fbclid": "${ .trigger.data.fbclid }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send welcome email",
            "description": "Analyze profile & send personalized intro"
          }
        }
      }
    ]
  }
}